void connectWiFi()
{
    Serial.println();
    Serial.println(
        "Connecting to Wi-Fi..."
    );

    WiFi.mode(WIFI_STA);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    int attempts = 0;

    while (
        WiFi.status() != WL_CONNECTED &&
        attempts < 30
    )
    {
        delay(500);

        Serial.print(".");

        attempts++;
    }

    Serial.println();

    if (
        WiFi.status() == WL_CONNECTED
    )
    {
        Serial.println(
            "Wi-Fi CONNECTED"
        );

        Serial.print(
            "IP address: "
        );

        Serial.println(
            WiFi.localIP()
        );

        Serial.print(
            "Signal RSSI: "
        );

        Serial.print(
            WiFi.RSSI()
        );

        Serial.println(
            " dBm"
        );
    }
    else
    {
        Serial.println(
            "Wi-Fi connection FAILED"
        );
    }
}

// ============================================================
// PARSE LORA PACKET
// ============================================================

bool parsePacket(String packet)
{
    /*
       NEW EXPECTED PACKET:

       AIRNODE01,
       MQ3,
       MQ8,
       TEMP,
       HUMIDITY,
       LATITUDE,
       LONGITUDE,
       ALTITUDE,
       SATELLITES,
       HDOP,
       GPS_FIX

       Example:

       AIRNODE01,1842,2130,28.45,61.20,
       28.459500,77.026600,214.30,8,0.90,1
    */

    packet.trim();

    Serial.println(
        "Parsing packet..."
    );

    // --------------------------------------------------------
    // We need 10 commas for 11 fields
    // --------------------------------------------------------

    int comma[10];

    int searchStart = 0;

    for (
        int i = 0;
        i < 10;
        i++
    )
    {
        comma[i] =
            packet.indexOf(
                ',',
                searchStart
            );

        if (
            comma[i] < 0
        )
        {
            Serial.println(
                "Not enough fields in packet"
            );

            return false;
        }

        searchStart =
            comma[i] + 1;
    }

    // --------------------------------------------------------
    // FIELD 0 - DEVICE ID
    // --------------------------------------------------------

    String id =
        packet.substring(
            0,
            comma[0]
        );

    if (
        id != "AIRNODE01"
    )
    {
        Serial.println(
            "Unknown device ID"
        );

        return false;
    }

    // --------------------------------------------------------
    // FIELD 1 - MQ3
    // --------------------------------------------------------

    String mq3 =
        packet.substring(
            comma[0] + 1,
            comma[1]
        );

    // --------------------------------------------------------
    // FIELD 2 - MQ8
    // --------------------------------------------------------

    String mq8 =
        packet.substring(
            comma[1] + 1,
            comma[2]
        );

    // --------------------------------------------------------
    // FIELD 3 - TEMPERATURE
    // --------------------------------------------------------

    String temperature =
        packet.substring(
            comma[2] + 1,
            comma[3]
        );

    // --------------------------------------------------------
    // FIELD 4 - HUMIDITY
    // --------------------------------------------------------

    String humidity =
        packet.substring(
            comma[3] + 1,
            comma[4]
        );

    // --------------------------------------------------------
    // FIELD 5 - LATITUDE
    // --------------------------------------------------------

    String lat =
        packet.substring(
            comma[4] + 1,
            comma[5]
        );

    // --------------------------------------------------------
    // FIELD 6 - LONGITUDE
    // --------------------------------------------------------

    String lon =
        packet.substring(
            comma[5] + 1,
            comma[6]
        );

    // --------------------------------------------------------
    // FIELD 7 - ALTITUDE
    // --------------------------------------------------------

    String alt =
        packet.substring(
            comma[6] + 1,
            comma[7]
        );

    // --------------------------------------------------------
    // FIELD 8 - SATELLITES
    // --------------------------------------------------------

    String sat =
        packet.substring(
            comma[7] + 1,
            comma[8]
        );

    // --------------------------------------------------------
    // FIELD 9 - HDOP
    // --------------------------------------------------------

    String hdopString =
        packet.substring(
            comma[8] + 1,
            comma[9]
        );

    // --------------------------------------------------------
    // FIELD 10 - GPS FIX
    // --------------------------------------------------------

    String fix =
        packet.substring(
            comma[9] + 1
        );

    // --------------------------------------------------------
    // CONVERT VALUES
    // --------------------------------------------------------

    mq3Value =
        mq3.toInt();

    mq8Value =
        mq8.toInt();

    dhtTemperature =
        temperature.toFloat();

    dhtHumidity =
        humidity.toFloat();

    latitude =
        lat.toDouble();

    longitude =
        lon.toDouble();

    altitude =
        alt.toFloat();

    satellites =
        sat.toInt();

    hdop =
        hdopString.toFloat();

    gpsFix =
        fix.toInt() == 1;

    deviceID =
        id;

    // --------------------------------------------------------
    // DEBUG
    // --------------------------------------------------------

    Serial.println(
        "Packet parsing SUCCESS"
    );

    return true;
}

// ============================================================
// RECEIVE LORA
// ============================================================

void receiveLoRa()
{
    String packet;

    int state =
        radio.receive(packet);

    if (
        state == RADIOLIB_ERR_NONE
    )
    {
        Serial.println();

        Serial.println(
            "======================================"
        );

        Serial.println(
            "LORA PACKET RECEIVED"
        );

        Serial.print(
            "RAW: "
        );

        Serial.println(
            packet
        );

        // ----------------------------------------------------
        // PARSE
        // ----------------------------------------------------

        if (
            parsePacket(packet)
        )
        {
            // ------------------------------------------------
            // RADIO QUALITY
            // ------------------------------------------------

            rssi =
                radio.getRSSI();

            snr =
                radio.getSNR();

            receivedData =
                true;

            lastPacketTime =
                millis();

            // ------------------------------------------------
            // PRINT VALUES
            // ------------------------------------------------

            Serial.println();

            Serial.println(
                "Parsed sensor data:"
            );

            Serial.print(
                "MQ-3: "
            );

            Serial.println(
                mq3Value
            );

            Serial.print(
                "MQ-8: "
            );

            Serial.println(
                mq8Value
            );

            Serial.print(
                "Temperature: "
            );

            Serial.print(
                dhtTemperature,
                2
            );

            Serial.println(
                " C"
            );

            Serial.print(
                "Humidity: "
            );

            Serial.print(
                dhtHumidity,
                2
            );

            Serial.println(
                " %"
            );

            Serial.print(
                "Latitude: "
            );

            Serial.println(
                latitude,
                6
            );

            Serial.print(
                "Longitude: "
            );

            Serial.println(
                longitude,
                6
            );

            Serial.print(
                "Altitude: "
            );

            Serial.print(
                altitude,
                2
            );

            Serial.println(
                " m"
            );

            Serial.print(
                "Satellites: "
            );

            Serial.println(
                satellites
            );

            Serial.print(
                "HDOP: "
            );

            Serial.println(
                hdop,
                2
            );

            Serial.print(
                "GPS Fix: "
            );

            Serial.println(
                gpsFix
                ? "YES"
                : "NO"
            );

            Serial.print(
                "LoRa RSSI: "
            );

            Serial.print(
                rssi,
                1
            );

            Serial.println(
                " dBm"
            );

            Serial.print(
                "LoRa SNR: "
            );

            Serial.print(
                snr,
                1
            );

            Serial.println(
                " dB"
            );
        }
        else
        {
            Serial.println(
                "INVALID PACKET FORMAT"
            );
        }

        Serial.println(
            "======================================"
        );

        // ----------------------------------------------------
        // CONTINUE RECEIVING
        // ----------------------------------------------------

        radio.startReceive();
    }

    else if (
        state ==
        RADIOLIB_ERR_CRC_MISMATCH
    )
    {
        Serial.println(
            "LoRa CRC error"
        );

        radio.startReceive();
    }

    else
    {
        radio.startReceive();
    }
}

// ============================================================
// SUPABASE UPLOAD
// ============================================================

void uploadToSupabase()
{
    if (
        !receivedData
    )
    {
        return;
    }

    if (
        millis() - lastUploadTime <
        UPLOAD_INTERVAL
    )
    {
        return;
    }

    lastUploadTime =
        millis();

    // --------------------------------------------------------
    // WIFI CHECK
    // --------------------------------------------------------

    if (
        WiFi.status() != WL_CONNECTED
    )
    {
        Serial.println(
            "Supabase upload skipped - Wi-Fi offline"
        );

        return;
    }

    // --------------------------------------------------------
    // HTTPS
    // --------------------------------------------------------

    WiFiClientSecure client;

    client.setInsecure();

    HTTPClient http;

    String url =
        String(SUPABASE_URL) +
        "/rest/v1/" +
        SUPABASE_TABLE;

    Serial.println();

    Serial.println(
        "Uploading to Supabase..."
    );

    Serial.print(
        "Supabase URL: "
    );

    Serial.println(
        url
    );

    if (
        !http.begin(
            client,
            url
        )
    )
    {
        Serial.println(
            "HTTP connection failed"
        );

        return;
    }

    // --------------------------------------------------------
    // HEADERS
    // --------------------------------------------------------

    http.addHeader(
        "Content-Type",
        "application/json"
    );

    http.addHeader(
        "apikey",
        SUPABASE_KEY
    );

    http.addHeader(
        "Authorization",
        "Bearer " +
        String(SUPABASE_KEY)
    );

    http.addHeader(
        "Prefer",
        "return=minimal"
    );

    // --------------------------------------------------------
    // JSON
    // --------------------------------------------------------

    String json = "{";

    json +=
        "\"device_id\":\"";

    json +=
        deviceID;

    json +=
        "\",";

    // MQ3

    json +=
        "\"mq3\":";

    json +=
        String(mq3Value);

    json +=
        ",";

    // MQ8

    json +=
        "\"mq8\":";

    json +=
        String(mq8Value);

    json +=
        ",";

    // Temperature

    json +=
        "\"dht22_temperature\":";

    json +=
        String(
            dhtTemperature,
            2
        );

    json +=
        ",";

    // Humidity

    json +=
        "\"dht22_humidity\":";

    json +=
        String(
            dhtHumidity,
            2
        );

    json +=
        ",";

    // Latitude

    json +=
        "\"latitude\":";

    json +=
        String(
            latitude,
            6
        );

    json +=
        ",";

    // Longitude

    json +=
        "\"longitude\":";

    json +=
        String(
            longitude,
            6
        );

    json +=
        ",";

    // Altitude

    json +=
        "\"altitude\":";

    json +=
        String(
            altitude,
            2
        );

    json +=
        ",";

    // Satellites

    json +=
        "\"gps_satellites\":";

    json +=
        String(
            satellites
        );

    json +=
        ",";

    // HDOP

    json +=
        "\"gps_hdop\":";

    json +=
        String(
            hdop,
            2
        );

    json +=
        ",";

    // GPS Fix

    json +=
        "\"gps_fix\":";

    json +=
        gpsFix
        ? "true"
        : "false";

    json +=
        ",";

    // RSSI

    json +=
        "\"rssi\":";

    json +=
        String(
            rssi,
            1
        );

    json +=
        ",";

    // SNR

    json +=
        "\"snr\":";

    json +=
        String(
            snr,
            1
        );

    json +=
        "}";

    // --------------------------------------------------------
    // DEBUG JSON
    // --------------------------------------------------------

    Serial.print(
        "Supabase JSON: "
    );

    Serial.println(
        json
    );

    // --------------------------------------------------------
    // POST
    // --------------------------------------------------------

    int httpCode =
        http.POST(
            json
        );

    Serial.print(
        "Supabase HTTP result: "
    );

    Serial.println(
        httpCode
    );

    // --------------------------------------------------------
    // RESULT
    // --------------------------------------------------------

    if (
        httpCode >= 200 &&
        httpCode < 300
    )
    {
        Serial.println(
            "Supabase upload SUCCESS"
        );
    }
    else
    {
        Serial.println(
            "Supabase upload FAILED"
        );

        Serial.print(
            "Supabase response: "
        );

        Serial.println(
            http.getString()
        );
    }

    http.end();
}

