void checkWiFi()
{
    if (
        millis() - lastWiFiCheck <
        WIFI_CHECK_INTERVAL
    )
    {
        return;
    }

    lastWiFiCheck =
        millis();

    if (
        WiFi.status() != WL_CONNECTED
    )
    {
        Serial.println(
            "Wi-Fi disconnected."
        );

        Serial.println(
            "Attempting reconnect..."
        );

        WiFi.disconnect();

        WiFi.begin(
            WIFI_SSID,
            WIFI_PASSWORD
        );
    }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
    Serial.begin(
        115200
    );

    delay(1500);

    Serial.println();

    Serial.println(
        "======================================"
    );

    Serial.println(
        " HELTEC WIFI LoRa 32 V3"
    );

    Serial.println(
        " NODE 2 - LoRa GATEWAY"
    );

    Serial.println(
        " MQ3 + MQ8 + DHT22 + GPS"
    );

    Serial.println(
        " Wi-Fi + Supabase + Web Server"
    );

    Serial.println(
        " OLED: NOT USED"
    );

    Serial.println(
        "======================================"
    );

    // ========================================================
    // LORA SPI
    // ========================================================

    Serial.println(
        "Starting LoRa SPI..."
    );

    spiLoRa.begin(
        LORA_SCK,
        LORA_MISO,
        LORA_MOSI,
        LORA_CS
    );

    delay(100);

    // ========================================================
    // SX1262
    // ========================================================

    Serial.println(
        "Initializing SX1262..."
    );

    int state =
        radio.begin(
            LORA_FREQUENCY,
            125.0,
            7,
            5,
            0x12,
            14,
            8,
            1.8
        );

    if (
        state != RADIOLIB_ERR_NONE
    )
    {
        Serial.print(
            "LoRa initialization FAILED: "
        );

        Serial.println(
            state
        );

        while (true)
        {
            delay(1000);
        }
    }

    Serial.println(
        "LoRa initialization SUCCESS"
    );

    radio.setOutputPower(
        14
    );

    radio.setCRC(
        true
    );

    // ========================================================
    // WIFI
    // ========================================================

    connectWiFi();

    // ========================================================
    // WEB SERVER
    // ========================================================

    server.on(
        "/",
        handleRoot
    );

    server.on(
        "/data",
        handleData
    );

    server.begin();

    Serial.println(
        "Web server started"
    );

    if (
        WiFi.status() ==
        WL_CONNECTED
    )
    {
        Serial.print(
            "Open browser at: http://"
        );

        Serial.println(
            WiFi.localIP()
        );
    }

    // ========================================================
    // START RECEIVER
    // ========================================================

    radio.startReceive();

    Serial.println();

    Serial.println(
        "======================================"
    );

    Serial.println(
        " GATEWAY READY"
    );

    Serial.println(
        " Waiting for LoRa packets..."
    );

    Serial.println(
        "======================================"
    );
}

// ============================================================
// LOOP
// ============================================================

void loop()
{
    // --------------------------------------------------------
    // WEB SERVER
    // --------------------------------------------------------

    server.handleClient();

    // --------------------------------------------------------
    // LORA
    // --------------------------------------------------------

    receiveLoRa();

    // --------------------------------------------------------
    // WIFI
    // --------------------------------------------------------

    checkWiFi();

    // --------------------------------------------------------
    // SUPABASE
    // --------------------------------------------------------

    uploadToSupabase();

    // --------------------------------------------------------
    // SENSOR TIMEOUT
    // --------------------------------------------------------

    if (
        receivedData &&
        millis() - lastPacketTime >
        15000
    )
    {
        receivedData =
            false;
    }

    delay(10);
}
