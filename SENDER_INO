/*
  ============================================================
  HELTEC WIFI LORA 32 V3
  AIR SENSOR + GPS TRANSMITTER
  ============================================================

  Sensors:
    MQ-3
    MQ-8
    DHT22
    NEO-6M GPS

  Display:
    Heltec onboard OLED

  Radio:
    SX1262 LoRa

  MPU9250:
    REMOVED

  ============================================================
*/

#include <Arduino.h>
#include <Wire.h>
#include "SSD1306Wire.h"
#include <DHT.h>
#include <TinyGPSPlus.h>
#include <RadioLib.h>

// ============================================================
// DEVICE
// ============================================================

#define DEVICE_ID "AIRNODE01"

// ============================================================
// MQ SENSORS
// ============================================================

#define MQ3_PIN 4
#define MQ8_PIN 5

// ============================================================
// DHT22
// ============================================================

#define DHT_PIN 6
#define DHT_TYPE DHT22

DHT dht(DHT_PIN, DHT_TYPE);

// ============================================================
// GPS NEO-6M
// ============================================================
//
// NEO-6M TX -> ESP32 GPIO47
// NEO-6M RX -> ESP32 GPIO48
//

#define GPS_RX_PIN 47
#define GPS_TX_PIN 48

#define GPS_BAUD 9600

HardwareSerial GPS_Serial(1);

TinyGPSPlus gps;

// ============================================================
// HELTEC V3 OLED
// ============================================================

#define OLED_SDA   17
#define OLED_SCL   18
#define OLED_RST   21
#define OLED_POWER 36

SSD1306Wire display(0x3C, OLED_SDA, OLED_SCL);

// ============================================================
// HELTEC V3 SX1262 LORA
// ============================================================

#define LORA_CS    8
#define LORA_DIO1  14
#define LORA_RST   12
#define LORA_BUSY  13

#define LORA_SCK   9
#define LORA_MISO  11
#define LORA_MOSI  10

#define LORA_FREQUENCY 865.0

SPIClass spiLoRa(FSPI);

SX1262 radio = new Module(
  LORA_CS,
  LORA_DIO1,
  LORA_RST,
  LORA_BUSY,
  spiLoRa
);

// ============================================================
// SENSOR VARIABLES
// ============================================================

int mq3Value = 0;
int mq8Value = 0;

float temperature = 0.0;
float humidity = 0.0;

// ============================================================
// GPS VARIABLES
// ============================================================

double latitude = 0.0;
double longitude = 0.0;

float altitude = 0.0;
float hdop = 0.0;

int satellites = 0;

bool gpsFix = false;

// ============================================================
// TIMING
// ============================================================

unsigned long lastSensorRead = 0;
unsigned long lastLoRaSend = 0;
unsigned long lastDisplayUpdate = 0;

const unsigned long SENSOR_INTERVAL  = 2000;
const unsigned long LORA_INTERVAL    = 5000;
const unsigned long DISPLAY_INTERVAL = 3000;

// ============================================================
// OLED PAGE
// ============================================================

int displayPage = 0;

const int TOTAL_PAGES = 4;

// ============================================================
// INITIALIZE OLED
// ============================================================

void initOLED()
{
  Serial.println("Initializing OLED...");

  // ----------------------------------------------------------
  // OLED POWER
  // ----------------------------------------------------------

  pinMode(OLED_POWER, OUTPUT);

  // Heltec V3 OLED power is active LOW
  digitalWrite(OLED_POWER, LOW);

  delay(100);

  // ----------------------------------------------------------
  // OLED RESET
  // ----------------------------------------------------------

  pinMode(OLED_RST, OUTPUT);

  digitalWrite(OLED_RST, LOW);

  delay(20);

  digitalWrite(OLED_RST, HIGH);

  delay(20);

  // ----------------------------------------------------------
  // I2C
  // ----------------------------------------------------------

  Wire.begin(
    OLED_SDA,
    OLED_SCL
  );

  delay(50);

  // ----------------------------------------------------------
  // DISPLAY
  // ----------------------------------------------------------

  display.init();

  display.clear();

  display.setFont(
    ArialMT_Plain_16
  );

  display.drawString(
    0,
    0,
    "AIRNODE01"
  );

  display.drawString(
    0,
    25,
    "STARTING..."
  );

  display.drawString(
    0,
    45,
    "PLEASE WAIT"
  );

  display.display();

  Serial.println("OLED initialized");
}

// ============================================================
// OLED PAGE 1
// ============================================================

void displayMQ()
{
  display.clear();

  display.setFont(
    ArialMT_Plain_16
  );

  display.drawString(
    0,
    0,
    "AIRNODE01"
  );

  display.drawString(
    0,
    20,
    "MQ3: " + String(mq3Value)
  );

  display.drawString(
    0,
    40,
    "MQ8: " + String(mq8Value)
  );

  display.display();
}

// ============================================================
// OLED PAGE 2
// ============================================================

void displayDHT()
{
  display.clear();

  display.setFont(
    ArialMT_Plain_16
  );

  display.drawString(
    0,
    0,
    "DHT22"
  );

  display.drawString(
    0,
    20,
    "T: " + String(temperature, 1) + " C"
  );

  display.drawString(
    0,
    40,
    "H: " + String(humidity, 1) + " %"
  );

  display.display();
}

// ============================================================
// OLED PAGE 3
// ============================================================

void displayGPS()
{
  display.clear();

  display.setFont(
    ArialMT_Plain_16
  );

  display.drawString(
    0,
    0,
    "GPS"
  );

  if (gpsFix)
  {
    display.drawString(
      0,
      20,
      "FIX: YES"
    );
  }
  else
  {
    display.drawString(
      0,
      20,
      "FIX: NO"
    );
  }

  display.drawString(
    0,
    40,
    "SAT: " + String(satellites)
  );

  display.display();
}

// ============================================================
// OLED PAGE 4
// ============================================================

void displayLocation()
{
  display.clear();

  display.setFont(
    ArialMT_Plain_10
  );

  if (gpsFix)
  {
    display.drawString(
      0,
      0,
      "GPS LOCATION"
    );

    display.drawString(
      0,
      15,
      "LAT: " + String(latitude, 5)
    );

    display.drawString(
      0,
      30,
      "LON: " + String(longitude, 5)
    );

    display.drawString(
      0,
      45,
      "ALT: " + String(altitude, 1) + " m"
    );
  }
  else
  {
    display.setFont(
      ArialMT_Plain_16
    );

    display.drawString(
      0,
      0,
      "GPS SEARCH"
    );

    display.drawString(
      0,
      25,
      "SAT: " + String(satellites)
    );

    display.drawString(
      0,
      45,
      "WAITING..."
    );
  }

  display.display();
}

// ============================================================
// UPDATE OLED
// ============================================================

void updateOLED()
{
  switch (displayPage)
  {
    case 0:
      displayMQ();
      break;

    case 1:
      displayDHT();
      break;

    case 2:
      displayGPS();
      break;

    case 3:
      displayLocation();
      break;
  }

  displayPage++;

  if (displayPage >= TOTAL_PAGES)
  {
    displayPage = 0;
  }
}

// ============================================================
// READ GPS
// ============================================================

void readGPS()
{
  while (GPS_Serial.available())
  {
    char c = GPS_Serial.read();

    gps.encode(c);
  }

  // ----------------------------------------------------------
  // LOCATION
  // ----------------------------------------------------------

  if (gps.location.isValid())
  {
    latitude = gps.location.lat();
    longitude = gps.location.lng();

    gpsFix = true;
  }
  else
  {
    gpsFix = false;
  }

  // ----------------------------------------------------------
  // ALTITUDE
  // ----------------------------------------------------------

  if (gps.altitude.isValid())
  {
    altitude = gps.altitude.meters();
  }

  // ----------------------------------------------------------
  // SATELLITES
  // ----------------------------------------------------------

  if (gps.satellites.isValid())
  {
    satellites = gps.satellites.value();
  }

  // ----------------------------------------------------------
  // HDOP
  // ----------------------------------------------------------

  if (gps.hdop.isValid())
  {
    hdop = gps.hdop.hdop();
  }
}

// ============================================================
// READ SENSORS
// ============================================================

void readSensors()
{
  // ----------------------------------------------------------
  // MQ3
  // ----------------------------------------------------------

  mq3Value = analogRead(
    MQ3_PIN
  );

  // ----------------------------------------------------------
  // MQ8
  // ----------------------------------------------------------

  mq8Value = analogRead(
    MQ8_PIN
  );

  // ----------------------------------------------------------
  // DHT22
  // ----------------------------------------------------------

  float newTemperature =
    dht.readTemperature();

  float newHumidity =
    dht.readHumidity();

  if (!isnan(newTemperature))
  {
    temperature = newTemperature;
  }

  if (!isnan(newHumidity))
  {
    humidity = newHumidity;
  }
}

// ============================================================
// PRINT SENSOR DATA
// ============================================================

void printSensorData()
{
  Serial.println();
  Serial.println(
    "======================================"
  );

  Serial.println(
    "AIRNODE01 SENSOR DATA"
  );

  Serial.println(
    "======================================"
  );

  // MQ

  Serial.print(
    "MQ-3: "
  );

  Serial.println(
    mq3Value
  );

  Serial.print(
    "MQ-8: "
  );

  Serial.println(
    mq8Value
  );

  // DHT

  Serial.print(
    "Temperature: "
  );

  Serial.print(
    temperature
  );

  Serial.println(
    " C"
  );

  Serial.print(
    "Humidity: "
  );

  Serial.print(
    humidity
  );

  Serial.println(
    " %"
  );

  // GPS

  Serial.print(
    "GPS Fix: "
  );

  Serial.println(
    gpsFix ? "YES" : "NO"
  );

  Serial.print(
    "Satellites: "
  );

  Serial.println(
    satellites
  );

  Serial.print(
    "Latitude: "
  );

  Serial.println(
    latitude,
    6
  );

  Serial.print(
    "Longitude: "
  );

  Serial.println(
    longitude,
    6
  );

  Serial.print(
    "Altitude: "
  );

  Serial.print(
    altitude
  );

  Serial.println(
    " m"
  );

  Serial.print(
    "HDOP: "
  );

  Serial.println(
    hdop
  );

  Serial.println(
    "======================================"
  );
}

// ============================================================
// SEND LORA
// ============================================================

void sendLoRa()
{
  char packet[300];

  /*
    Packet format:

    DEVICE_ID,
    MQ3,
    MQ8,
    TEMP,
    HUMIDITY,
    LATITUDE,
    LONGITUDE,
    ALTITUDE,
    SATELLITES,
    HDOP,
    GPS_FIX
  */

  snprintf(
    packet,
    sizeof(packet),

    "%s,%d,%d,%.2f,%.2f,%.6f,%.6f,%.2f,%d,%.2f,%d",

    DEVICE_ID,

    mq3Value,
    mq8Value,

    temperature,
    humidity,

    latitude,
    longitude,

    altitude,

    satellites,

    hdop,

    gpsFix ? 1 : 0
  );

  Serial.println();
  Serial.println(
    "LoRa TRANSMIT:"
  );

  Serial.println(
    packet
  );

  int state =
    radio.transmit(packet);

  if (state == RADIOLIB_ERR_NONE)
  {
    Serial.println(
      "LoRa TX SUCCESS"
    );
  }
  else
  {
    Serial.print(
      "LoRa TX FAILED: "
    );

    Serial.println(
      state
    );
  }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(
    115200
  );

  delay(1000);

  Serial.println();
  Serial.println(
    "======================================"
  );

  Serial.println(
    "HELTEC WIFI LORA 32 V3"
  );

  Serial.println(
    "AIR SENSOR + GPS"
  );

  Serial.println(
    "======================================"
  );

  // ==========================================================
  // OLED FIRST
  // ==========================================================

  initOLED();

  delay(1000);

  // ==========================================================
  // ANALOG INPUT
  // ==========================================================

  analogReadResolution(12);

  pinMode(
    MQ3_PIN,
    INPUT
  );

  pinMode(
    MQ8_PIN,
    INPUT
  );

  // ==========================================================
  // DHT22
  // ==========================================================

  Serial.println(
    "Initializing DHT22..."
  );

  dht.begin();

  // ==========================================================
  // GPS
  // ==========================================================

  Serial.println(
    "Initializing GPS..."
  );

  GPS_Serial.begin(
    GPS_BAUD,
    SERIAL_8N1,
    GPS_RX_PIN,
    GPS_TX_PIN
  );

  Serial.println(
    "GPS UART started"
  );

  // Show GPS initialization on OLED

  display.clear();

  display.setFont(
    ArialMT_Plain_16
  );

  display.drawString(
    0,
    0,
    "GPS"
  );

  display.drawString(
    0,
    25,
    "SEARCHING..."
  );

  display.display();

  // ==========================================================
  // LORA SPI
  // ==========================================================

  Serial.println(
    "Initializing LoRa..."
  );

  spiLoRa.begin(
    LORA_SCK,
    LORA_MISO,
    LORA_MOSI,
    LORA_CS
  );

  // ==========================================================
  // LORA
  // ==========================================================

  int state =
    radio.begin(
      LORA_FREQUENCY,
      125.0,
      7,
      5,
      0x12,
      14,
      8,
      1.8
    );

  if (state != RADIOLIB_ERR_NONE)
  {
    Serial.print(
      "LoRa initialization FAILED: "
    );

    Serial.println(
      state
    );

    // Do NOT stop the entire program.
    // Keep GPS/sensors/OLED working.

    display.clear();

    display.setFont(
      ArialMT_Plain_16
    );

    display.drawString(
      0,
      0,
      "LORA ERROR"
    );

    display.drawString(
      0,
      25,
      String(state)
    );

    display.drawString(
      0,
      45,
      "CHECK RADIO"
    );

    display.display();

    delay(2000);
  }
  else
  {
    Serial.println(
      "LoRa initialization SUCCESS"
    );

    radio.setOutputPower(
      14
    );

    radio.setCRC(
      true
    );

    display.clear();

    display.setFont(
      ArialMT_Plain_16
    );

    display.drawString(
      0,
      0,
      "AIRNODE01"
    );

    display.drawString(
      0,
      25,
      "SYSTEM READY"
    );

    display.drawString(
      0,
      45,
      "LORA + GPS"
    );

    display.display();

    delay(2000);
  }

  // ==========================================================
  // INITIAL READ
  // ==========================================================

  readSensors();
  readGPS();

  updateOLED();

  lastSensorRead =
    millis();

  lastLoRaSend =
    millis();

  lastDisplayUpdate =
    millis();
}

// ============================================================
// LOOP
// ============================================================

void loop()
{
  // ==========================================================
  // GPS MUST BE READ CONTINUOUSLY
  // ==========================================================

  readGPS();

  // ==========================================================
  // SENSOR READING
  // ==========================================================

  if (
    millis() - lastSensorRead >=
    SENSOR_INTERVAL
  )
  {
    lastSensorRead =
      millis();

    readSensors();

    printSensorData();
  }

  // ==========================================================
  // OLED
  // ==========================================================

  if (
    millis() - lastDisplayUpdate >=
    DISPLAY_INTERVAL
  )
  {
    lastDisplayUpdate =
      millis();

    updateOLED();
  }

  // ==========================================================
  // LORA
  // ==========================================================

  if (
    millis() - lastLoRaSend >=
    LORA_INTERVAL
  )
  {
    lastLoRaSend =
      millis();

    sendLoRa();
  }
}
